<style>
:root {
  --cream:        #F7EFE3;
  --cream-dark:   #EDE0CC;
  --cream-card:   #FDF8F2;
  --brown:        #2B1F14;
  --brown-mid:    #5C3D1E;
  --orange:       #D4782A;
  --orange-light: #E8943A;
  --gold:         #B8862A;
  --gold-light:   #D4A94A;
  --green:        #4A6B30;
  --white:        #FFFFFF;
  --gray-soft:    #8A7A6A;
  --shadow:       0 4px 24px rgba(43,31,20,0.10);
  --shadow-lg:    0 8px 48px rgba(43,31,20,0.15);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Lato', sans-serif;
  background: var(--cream);
  color: var(--brown);
  overflow-x: hidden;
  line-height: 1.6;
}

/* ── BANNER ── */
.top-banner {
  background: linear-gradient(135deg, var(--brown), #3D2810);
  color: var(--white);
  text-align: center;
  padding: 13px 20px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.03em;
}
.top-banner span { color: var(--gold-light); }

/* ── HERO ── */
.hero {
  background: linear-gradient(155deg, #0A1628 0%, #0D2147 45%, #102A5A 100%);
  padding: 52px 20px 52px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 0%, rgba(80,140,255,0.18) 0%, transparent 70%);
  pointer-events: none;
}
.hero-tag {
  display: inline-block;
  background: linear-gradient(90deg, #FF6B2B, #FF8C42);
  color: var(--white);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 6px 20px;
  border-radius: 50px;
  margin-bottom: 18px;
  box-shadow: 0 0 24px rgba(255,107,43,0.45);
  animation: pulse-tag 2s infinite;
}
@keyframes pulse-tag {
  0%,100% { box-shadow: 0 0 18px rgba(255,107,43,0.4); }
  50%      { box-shadow: 0 0 36px rgba(255,107,43,0.75); }
}
.hero-thanks {
  font-size: 15px;
  font-weight: 700;
  color: rgba(180,210,255,0.85);
  margin-bottom: 14px;
  letter-spacing: 0.02em;
}
.hero-title {
  font-family: 'Playfair Display', serif;
  font-weight: 900;
  font-size: clamp(28px, 6vw, 52px);
  color: #FFFFFF;
  line-height: 1.1;
  max-width: 700px;
  margin: 0 auto 16px;
  text-shadow: 0 2px 24px rgba(0,0,0,0.3);
}
.hero-title em {
  color: #FFD166;
  font-style: normal;
}
.hero-urgency {
  display: inline-block;
  background: rgba(255,209,102,0.12);
  border: 1px solid rgba(255,209,102,0.35);
  color: #FFD166;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 0.04em;
  padding: 7px 20px;
  border-radius: 8px;
  margin-bottom: 16px;
  text-transform: uppercase;
}
.hero-sub {
  font-size: clamp(15px, 2vw, 17px);
  color: rgba(200,220,255,0.80);
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.65;
}

/* ── VALOR TABLE ── */
.value-section {
  background: linear-gradient(160deg, #0A1628 0%, #0D2147 50%, #102A5A 100%);
  padding: 48px 20px;
  position: relative;
  overflow: hidden;
}
.value-section::before {
  content: '✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦';
  position: absolute;
  top: 12px;
  left: 0; right: 0;
  text-align: center;
  font-size: 11px;
  color: rgba(80,140,255,0.30);
  letter-spacing: 6px;
  pointer-events: none;
}
.value-section::after {
  content: '✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦';
  position: absolute;
  bottom: 12px;
  left: 0; right: 0;
  text-align: center;
  font-size: 11px;
  color: rgba(80,140,255,0.30);
  letter-spacing: 6px;
  pointer-events: none;
}
.value-inner {
  max-width: 620px;
  margin: 0 auto;
}
.value-label {
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #FFD166;
  text-align: center;
  margin-bottom: 20px;
}
.value-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--white);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--shadow);
}
.value-table th {
  background: var(--brown);
  color: var(--white);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 12px 20px;
  text-align: left;
}
.value-table th:last-child { text-align: right; }
.value-table td {
  padding: 13px 20px;
  font-size: 15px;
  color: var(--brown);
  border-bottom: 1px solid var(--cream-dark);
}
.value-table td:last-child {
  text-align: right;
  font-weight: 900;
  color: var(--gray-soft);
  text-decoration: line-through;
  font-size: 14px;
}
.value-table tr:last-child td { border-bottom: none; }
.value-table tr:last-child td:first-child {
  font-weight: 900;
  color: var(--brown);
}
.value-total-row td {
  background: linear-gradient(135deg, #FAF2E4, #F5E8D0);
  border-top: 2px solid var(--gold) !important;
  border-bottom: none !important;
  font-weight: 900 !important;
}
.value-total-row td:first-child { color: var(--brown) !important; font-size: 16px; }
.value-total-row td:last-child {
  text-decoration: none !important;
  color: var(--orange) !important;
  font-size: 20px !important;
  font-family: 'Playfair Display', serif;
}
.value-footer {
  text-align: center;
  margin-top: 16px;
  font-size: 14px;
  color: rgba(200,220,255,0.80);
  font-weight: 700;
}
.value-footer strong { color: #FFD166; }

/* ── EBOOKS LIST ── */
.ebooks-section {
  background: linear-gradient(160deg, #EEF4FF 0%, #E0ECFF 60%, #D6E6FF 100%);
  padding: 48px 20px;
  position: relative;
  overflow: hidden;
}
.ebooks-section::before {
  content: '✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦';
  position: absolute;
  top: 12px;
  left: 0; right: 0;
  text-align: center;
  font-size: 11px;
  color: rgba(100,150,255,0.35);
  letter-spacing: 6px;
  pointer-events: none;
}
.ebooks-section::after {
  content: '✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦ ✧ ✦';
  position: absolute;
  bottom: 12px;
  left: 0; right: 0;
  text-align: center;
  font-size: 11px;
  color: rgba(100,150,255,0.35);
  letter-spacing: 6px;
  pointer-events: none;
}
.ebooks-inner {
  max-width: 620px;
  margin: 0 auto;
}
.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(22px, 4vw, 32px);
  font-weight: 900;
  color: var(--brown);
  margin-bottom: 6px;
}
.section-title em { color: var(--orange); font-style: normal; }
.section-desc {
  font-size: 15px;
  color: var(--brown-mid);
  margin-bottom: 28px;
  line-height: 1.6;
}
.ebook-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.ebook-item {
  display: flex;
  align-items: center;
  gap: 16px;
  background: var(--white);
  border-radius: 14px;
  padding: 16px 20px;
  box-shadow: var(--shadow);
  border-left: 4px solid var(--orange);
}
.ebook-emoji {
  font-size: 26px;
  flex-shrink: 0;
  width: 42px;
  text-align: center;
}
.ebook-text strong {
  display: block;
  font-size: 15px;
  font-weight: 900;
  color: var(--brown);
  margin-bottom: 2px;
}
.ebook-text span {
  font-size: 13px;
  color: var(--gray-soft);
  line-height: 1.5;
}
.ebook-price {
  margin-left: auto;
  font-size: 13px;
  font-weight: 900;
  color: var(--gray-soft);
  text-decoration: line-through;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ── CTA BLOCK ── */
.cta-section {
  background: linear-gradient(160deg, #EEF4FF 0%, #E0ECFF 60%, #D6E6FF 100%);
  padding: 52px 20px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.cta-section::before {
  content: '★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★';
  position: absolute;
  top: 12px;
  left: 0; right: 0;
  text-align: center;
  font-size: 11px;
  color: rgba(100,150,255,0.35);
  letter-spacing: 6px;
  pointer-events: none;
}
.cta-section::after {
  content: '★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★ ✦ ★';
  position: absolute;
  bottom: 12px;
  left: 0; right: 0;
  text-align: center;
  font-size: 11px;
  color: rgba(100,150,255,0.35);
  letter-spacing: 6px;
  pointer-events: none;
}
.cta-inner {
  max-width: 480px;
  margin: 0 auto;
}
.cta-heading {
  font-family: 'Playfair Display', serif;
  font-size: clamp(24px, 4.5vw, 36px);
  font-weight: 900;
  color: var(--brown);
  line-height: 1.2;
  margin-bottom: 8px;
}
.cta-heading em { color: var(--orange); font-style: normal; }
.cta-desc {
  font-size: 15px;
  color: var(--brown-mid);
  margin-bottom: 28px;
  line-height: 1.6;
}

.price-block {
  background: var(--white);
  border-radius: 20px;
  padding: 32px 28px 24px;
  box-shadow: var(--shadow-lg);
  border: 2px solid var(--cream-dark);
  position: relative;
  margin-bottom: 0;
}
.price-tag {
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--green);
  color: var(--white);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 5px 20px;
  border-radius: 50px;
  white-space: nowrap;
}
.price-old {
  font-size: 14px;
  color: var(--gray-soft);
  text-decoration: line-through;
  font-weight: 700;
  margin-bottom: 2px;
}
.price-now {
  font-family: 'Playfair Display', serif;
  font-size: clamp(52px, 10vw, 72px);
  font-weight: 900;
  color: var(--orange);
  line-height: 1;
  margin-bottom: 4px;
}
.price-now sup { font-size: 0.42em; vertical-align: super; }
.price-note {
  font-size: 13px;
  color: var(--gray-soft);
  margin-bottom: 22px;
}

/* Countdown */
.cd-wrap {
  background: linear-gradient(135deg, #3D2409, #5C3A14);
  border-radius: 12px;
  padding: 14px 20px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}
.cd-label-text {
  font-size: 13px;
  font-weight: 700;
  color: rgba(255,255,255,0.8);
  white-space: nowrap;
}
.cd-digits {
  display: flex;
  align-items: center;
  gap: 6px;
}
.cd-num {
  background: var(--orange);
  color: var(--white);
  font-size: 22px;
  font-weight: 900;
  border-radius: 8px;
  padding: 4px 10px;
  min-width: 46px;
  text-align: center;
  font-variant-numeric: tabular-nums;
}
.cd-sep { color: var(--gold-light); font-weight: 900; font-size: 20px; }

/* Buttons */
.btn-yes {
  display: block;
  width: 100%;
  background: linear-gradient(135deg, var(--orange), var(--orange-light));
  color: var(--white);
  font-family: 'Lato', sans-serif;
  font-weight: 900;
  font-size: 16px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 18px 24px;
  border-radius: 50px;
  border: none;
  cursor: pointer;
  text-decoration: none;
  box-shadow: 0 6px 28px rgba(212,120,42,0.38);
  transition: transform 0.18s, box-shadow 0.18s;
  text-align: center;
  margin-bottom: 12px;
}
.btn-yes:hover { transform: translateY(-2px); box-shadow: 0 10px 36px rgba(212,120,42,0.50); }

.btn-no {
  display: block;
  width: 100%;
  background: none;
  border: none;
  font-family: 'Lato', sans-serif;
  font-size: 13px;
  color: var(--gray-soft);
  text-decoration: underline;
  cursor: pointer;
  padding: 6px;
  transition: color 0.18s;
}
.btn-no:hover { color: var(--brown-mid); }

.guarantee {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  flex-wrap: wrap;
  font-size: 13px;
  font-weight: 700;
  color: var(--green);
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid var(--cream-dark);
  text-align: center;
}

/* ── FOOTER ── */
footer {
  background: var(--brown);
  color: rgba(255,255,255,0.5);
  text-align: center;
  padding: 24px 20px;
  font-size: 12px;
  line-height: 1.7;
}
footer a { color: rgba(255,255,255,0.55); text-decoration: underline; }

/* ── RESPONSIVE ── */
@media (max-width: 500px) {
  .value-table th, .value-table td { padding: 10px 14px; }
  .ebook-item { padding: 14px 16px; }
  .price-block { padding: 28px 18px 20px; }
  .ebook-price { display: none; }
}
</style>
</head>
