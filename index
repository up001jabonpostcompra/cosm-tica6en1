<script>
// ── COUNTDOWN 5 min ──
(function () {
  const KEY = 'up_cd_end_v3', DURATION = 5 * 60;
  let end = parseInt(sessionStorage.getItem(KEY) || '0');
  const now = Math.floor(Date.now() / 1000);
  if (!end || end <= now) { end = now + DURATION; sessionStorage.setItem(KEY, end); }
  function pad(n) { return String(n).padStart(2, '0'); }
  function tick() {
    const r = Math.max(0, end - Math.floor(Date.now() / 1000));
    const elM = document.getElementById('cdM'), elS = document.getElementById('cdS');
    if (elM) elM.textContent = pad(Math.floor(r / 60));
    if (elS) elS.textContent = pad(r % 60);
    if (r > 0) { setTimeout(tick, 1000); }
    // Al llegar a 0 se queda en 00:00 y el botón sigue activo
  }
  tick();
})();

// ── SKIP ──
document.getElementById('skipBtn').addEventListener('click', function () {
  window.location.href = '#gracias'; // reemplazar con URL de página de gracias Hotmart
});

// ── SCROLL REVEAL ──
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.style.opacity = '1'; e.target.style.transform = 'translateY(0)'; obs.unobserve(e.target); }
  });
}, { threshold: 0.08 });
document.querySelectorAll('.ebook-item, .price-block, .value-table').forEach(el => {
  el.style.opacity = '0'; el.style.transform = 'translateY(18px)';
  el.style.transition = 'opacity 0.45s ease, transform 0.45s ease';
  obs.observe(el);
});
</script>
